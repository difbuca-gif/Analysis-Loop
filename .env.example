# 역할별 LLM 백엔드 — 코드 수정 없이 vLLM <-> SGLang <-> Ollama 전환용.
# PROVIDER: local | nvidia | ollama | none

# 메인 9B — 연구 질문(ResearchIntent)만 만든다. 코드는 만들지 않는다.
PLANNER_LLM_PROVIDER=local
PLANNER_LLM_BASE_URL=http://localhost:8000/v1
PLANNER_LLM_MODEL=Qwen/Qwen3.5-9B
PLANNER_LLM_MAX_TOKENS=2048

# 분석 코드 + Manifest 생성 — 커스텀 분석을 담당한다.
# 코드와 Manifest를 한 응답에 담으므로 충분한 출력 길이가 필요하다.
CODEGEN_LLM_PROVIDER=nvidia
CODEGEN_LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
CODEGEN_LLM_MAX_TOKENS=8192

# Critic — **반드시 CODEGEN과 다른 endpoint/model이어야 한다.**
# 코드 생성 모델과 같으면 이중 리뷰가 자기검증이 되어 correlated error를 못 거른다.
CRITIC_LLM_PROVIDER=local
CRITIC_LLM_BASE_URL=http://localhost:8000/v1
CRITIC_LLM_MODEL=Qwen/Qwen3.5-9B
CRITIC_LLM_MAX_TOKENS=1024

NVIDIA_API_KEY=

# FastAPI 서버(src/analysis_loop_v3/api/). CLI는 이 값들 없이도 동작한다.
# DATABASE_URL은 실행 레지스트리 저장에 사용한다.
DATABASE_URL=postgresql+asyncpg://analysis:analysis@localhost:5432/analysis_loop_v3
# Control API 인증 토큰. 비우면 루프백 요청만 받는다.
# 외부 인터페이스로 노출할 때는 토큰을 설정한다.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8100
# CLI의 기본 --workspace와 동일한 개념. 여러 run이 이 아래
# checkpoints.sqlite/artifacts/events/memory를 공유한다.
ANALYSIS_WORKSPACE=runs
# API가 분석 대상으로 받을 수 있는 최상위 디렉터리. 비우면 제한하지 않는다.
ANALYSIS_DATA_ROOT=

# 원격 Compute Worker(execution/remote_sandbox.py).
# 비워두면 SubprocessSandbox를 사용하고, 설정하면 Worker API로 실행을 위임한다.
WORKER_URL=
# Worker를 이 머신에서 띄울 때만 쓴다(python -m analysis_loop_v3.worker).
# 127.0.0.1이 아닌 주소로 노출하려면 WORKER_TOKEN이 반드시 있어야 기동된다.
WORKER_HOST=127.0.0.1
WORKER_PORT=8200
WORKER_TOKEN=
WORKER_STATE_DIR=worker-state/executions
